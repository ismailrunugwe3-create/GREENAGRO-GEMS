{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greenagro-gems-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greenagro-gemsdb",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}